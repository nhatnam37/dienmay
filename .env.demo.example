# CHỈ DEMO. Ba mật khẩu DB vẫn phải tự đặt; tài khoản app dùng mật khẩu giả lập đã công bố.
# Sao chép thành .env, tự đặt ba mật khẩu DB KHÁC NHAU. Không commit .env.
# Mật khẩu demo giả lập được công bố; ba mật khẩu DB phải tự đặt, không dùng cho prod.
COMPOSE_PROJECT_NAME=dienmay_demo
APP_PROFILE=demo
DB_NAME=dienmay_demo
DB_USER=dienmay
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
FLYWAY_USER=dienmay_migration
FLYWAY_PASSWORD=
INITIAL_ADMIN_USERNAME=admin
# Chỉ demo: không qua bootstrap admin của prod. Prod dùng mẫu .env.example/mật khẩu mạnh.
INITIAL_ADMIN_PASSWORD=Admin@123
# Đường dẫn TRONG container; phải là /app/uploads hoặc thư mục con.
UPLOAD_DIR=/app/uploads
LOGIN_PAIR_LIMIT=5
LOGIN_IP_LIMIT=50
LOGIN_WINDOW=PT5M
LOGIN_BLOCK_DURATION=PT5M
LOGIN_CLEANUP_INTERVAL=PT1M
LOGIN_MAX_ENTRIES=100000
LOGIN_TRUST_FORWARDED_FOR=false
# Danh sách IP proxy đáng tin, cách nhau bằng dấu phẩy; để trống khi không có proxy.
LOGIN_TRUSTED_PROXY_ADDRESSES=
QUERY_MAX_PAGE=10000
QUERY_MAX_SIZE=50
QUERY_MAX_KEYWORD_LENGTH=100
REPORT_EXPORT_MAX_ROWS=50000
REPORT_LOW_STOCK_THRESHOLD=5
WARRANTY_LOOKUP_RATE_PER_MINUTE=20
ORDER_EXPIRY_ENABLED=true
# false để thử localhost HTTP; triển khai HTTPS đặt true và cấu hình reverse proxy đúng.
SESSION_COOKIE_SECURE=false
FORWARD_HEADERS_STRATEGY=NONE
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -Duser.timezone=Asia/Ho_Chi_Minh

DEMO_SEED=true
DEMO_SEED_VALUE=20261023
